\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Training curves for all Task 3 models; ERM is the reused Task 2 run. (a) Classification loss on the source batches, on a logarithmic axis. (b) The weighted pairwise source MMD penalty $\lambda _{\mathrm  {DG}}\cdot \mathrm  {MMD}^2$ for the three DAN-DG settings. (c) Mean source-validation macro-F1, the checkpoint-selection signal. At $\lambda _{\mathrm  {DG}}=10$ the classification loss stays between 1.74 and 1.95 for all 23 epochs, close to the $\ln 7 = 1.946$ of a uniform seven-class prediction, and source-validation macro-F1 never exceeds 16.06\%. Curves end at the epoch where early stopping triggered; the selected checkpoints are epoch 11 (ERM), 1 (DAN-DG, $\lambda _{\mathrm  {DG}}=1$), 11 (SAM), 7 ($\lambda _{\mathrm  {DG}}=0.1$) and 18 ($\lambda _{\mathrm  {DG}}=10$).}}{15}{figure.caption.17}\protected@file@percent }
\newlabel{fig:task3_training}{{10}{15}{Training curves for all Task 3 models; ERM is the reused Task 2 run. (a) Classification loss on the source batches, on a logarithmic axis. (b) The weighted pairwise source MMD penalty $\lambda _{\mathrm {DG}}\cdot \mathrm {MMD}^2$ for the three DAN-DG settings. (c) Mean source-validation macro-F1, the checkpoint-selection signal. At $\lambda _{\mathrm {DG}}=10$ the classification loss stays between 1.74 and 1.95 for all 23 epochs, close to the $\ln 7 = 1.946$ of a uniform seven-class prediction, and source-validation macro-F1 never exceeds 16.06\%. Curves end at the epoch where early stopping triggered; the selected checkpoints are epoch 11 (ERM), 1 (DAN-DG, $\lambda _{\mathrm {DG}}=1$), 11 (SAM), 7 ($\lambda _{\mathrm {DG}}=0.1$) and 18 ($\lambda _{\mathrm {DG}}=10$)}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Top:} controlled study over $\lambda _{\mathrm  {DG}}\in \{0.1,1,10\}$, with mean source macro-F1, Sketch macro-F1 and source-domain separability on a common percentage axis; the dotted line is separability chance (33.3\%). Moving from 0.1 to 1 changes all three quantities by less than 1.5 points, while $\lambda _{\mathrm  {DG}}=10$ pushes separability to 48.84\% and collapses both source and Sketch macro-F1. \textbf  {Bottom:} per-class Sketch accuracy change against ERM for each Task 3 model. At $\lambda _{\mathrm  {DG}}=10$ only \texttt  {house} improves.}}{16}{figure.caption.18}\protected@file@percent }
\newlabel{fig:task3_alignment}{{11}{16}{\textbf {Top:} controlled study over $\lambda _{\mathrm {DG}}\in \{0.1,1,10\}$, with mean source macro-F1, Sketch macro-F1 and source-domain separability on a common percentage axis; the dotted line is separability chance (33.3\%). Moving from 0.1 to 1 changes all three quantities by less than 1.5 points, while $\lambda _{\mathrm {DG}}=10$ pushes separability to 48.84\% and collapses both source and Sketch macro-F1. \textbf {Bottom:} per-class Sketch accuracy change against ERM for each Task 3 model. At $\lambda _{\mathrm {DG}}=10$ only \texttt {house} improves}{figure.caption.18}{}}
