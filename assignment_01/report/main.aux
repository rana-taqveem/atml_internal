\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Target-Aware DAN versus Target-Free DAN-DG}{17}{subsection.3.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Target-aware DAN (Task 2) and target-free DAN-DG (Task 3) against the shared ERM checkpoint. Both use the same MMD implementation and RBF kernel construction.}}{17}{table.caption.20}\protected@file@percent }
\newlabel{tab:task3_target_access}{{7}{17}{Target-aware DAN (Task 2) and target-free DAN-DG (Task 3) against the shared ERM checkpoint. Both use the same MMD implementation and RBF kernel construction}{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Per-class Sketch accuracy change against the shared ERM checkpoint for target-aware DAN (Task 2) and target-free DAN-DG (Task 3). Both improve \texttt  {giraffe}, \texttt  {guitar}, \texttt  {horse} and \texttt  {house}. They diverge on \texttt  {dog} ($+26.81$ for DAN, $-0.13$ for DAN-DG) and \texttt  {elephant} ($-1.62$ against $+7.43$), and both lose accuracy on \texttt  {person}, DAN-DG by far more ($-33.75$ against $-1.25$).}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:task3_vs_task2}{{13}{18}{Per-class Sketch accuracy change against the shared ERM checkpoint for target-aware DAN (Task 2) and target-free DAN-DG (Task 3). Both improve \texttt {giraffe}, \texttt {guitar}, \texttt {horse} and \texttt {house}. They diverge on \texttt {dog} ($+26.81$ for DAN, $-0.13$ for DAN-DG) and \texttt {elephant} ($-1.62$ against $+7.43$), and both lose accuracy on \texttt {person}, DAN-DG by far more ($-33.75$ against $-1.25$)}{figure.caption.21}{}}
